[Unit]
Description=meera-notch Lightweight Dynamic Bezel Daemon (Sholat, Quran, System, Pomodoro)
Documentation=https://github.com/rizqinrr/meera-notch
PartOf=graphical-session.target
After=graphical-session.target pipewire.service

[Service]
Type=dbus
BusName=io.github.rizqinrr.MeeraNotch
ExecStart=%h/.local/bin/meera-notchd
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
